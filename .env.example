# Postgres (docker compose up -d → port 5433)
DATABASE_URL=postgres://lastro:lastro@localhost:5433/lastro

# 32+ random chars: openssl rand -base64 48
SESSION_SECRET=

# Public origin of the app. WebAuthn RP ID must be the host (no scheme/port).
APP_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Lastro

# testnet | public
STELLAR_NETWORK=testnet
# Optional override; defaults to SDF Horizon for the network above
# HORIZON_URL=

# Lastro keys (pnpm stellar:setup generates and funds them on testnet)
# Issuer: issues every Lastro token; flags AUTH_REQUIRED | AUTH_REVOCABLE | AUTH_CLAWBACK_ENABLED
LASTRO_ISSUER_SECRET=
# Operator: treasury that holds and distributes tokens, pays fees, sponsors client reserves
LASTRO_OPERATOR_SECRET=
