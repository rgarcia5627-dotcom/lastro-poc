{
  "name": "lastro",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Lastro: tokenization and management of Brazilian private-credit assets as Stellar classic assets, with passkey wallets for institutional investors.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "stellar:setup": "tsx scripts/stellar-setup.ts",
    "admin:invite": "tsx scripts/create-admin-invite.ts",
    "smoke:testnet": "tsx scripts/testnet-smoke.ts",
    "test:e2e": "pnpm build && playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@stellar/stellar-sdk": "^14.6.1",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "15.5.29",
    "postgres": "^3.4.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
